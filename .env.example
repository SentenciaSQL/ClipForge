# AI Video Clipper — Environment Configuration
# Copy this file to .env and adjust for your machine.

# Backend
AVC_HOST=127.0.0.1
AVC_PORT=8000
AVC_DEBUG=true
# Leave empty to use workspace/projects/ai_video_clipper.db under the repo root.
AVC_DATABASE_URL=
AVC_WORKSPACE_PATH=./workspace
AVC_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,tauri://localhost,http://tauri.localhost

# FFmpeg (leave empty to use PATH)
AVC_FFMPEG_PATH=
AVC_FFPROBE_PATH=

# Ollama (local only)
AVC_OLLAMA_URL=http://127.0.0.1:11434
AVC_OLLAMA_MODEL=qwen3:8b

# Whisper
AVC_WHISPER_MODEL=large-v3
AVC_WHISPER_DEVICE=auto
AVC_WHISPER_COMPUTE_TYPE=auto

# GPU / hardware
AVC_PREFER_GPU=true
AVC_MAX_CONCURRENT_JOBS=1
AVC_USE_NVENC=auto

# Rendering defaults
AVC_OUTPUT_WIDTH=1080
AVC_OUTPUT_HEIGHT=1920
AVC_OUTPUT_FPS=30
AVC_CRF=20
AVC_CLIP_MIN_SECONDS=12
AVC_CLIP_MAX_SECONDS=30
