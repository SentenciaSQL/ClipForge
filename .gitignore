# Environment
.env
.env.local
*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Node / Angular
node_modules/
.angular/
dist/
.npm/
*.log
npm-debug.log*
yarn-error.log
pnpm-debug.log*

# Desktop (Angular / Tauri) — heavy local artifacts
desktop/**/node_modules/
desktop/**/dist/
desktop/**/.angular/
desktop/**/out-tsc/
desktop/**/tmp/
desktop/**/coverage/
desktop/angular-app/src-tauri/target/
desktop/angular-app/src-tauri/gen/
desktop/angular-app/src-tauri/WixTools/
desktop/angular-app/src-tauri/sidecars/*
!desktop/angular-app/src-tauri/sidecars/.gitkeep
desktop/**/*.exe
desktop/**/*.msi
desktop/**/*.nsis.zip
desktop/**/*.dmg
desktop/**/*.AppImage
desktop/**/*.app/
desktop/**/*.deb
desktop/**/*.rpm
# PyInstaller / sidecar build leftovers under desktop or backend
desktop/**/build/
*.spec
backend/dist/
backend/build/

# Workspace runtime data
workspace/originals/*
!workspace/originals/.gitkeep
workspace/projects/*
!workspace/projects/.gitkeep
workspace/temporary/*
!workspace/temporary/.gitkeep
workspace/exports/*
!workspace/exports/.gitkeep
*.db
*.db-journal
*.db-shm
*.db-wal

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Models (downloaded locally)
backend/models/*
!backend/models/.gitkeep
*.pt
*.bin
*.onnx
*.gguf

# Coverage / test artifacts (tests intentionally not part of this project)
.coverage
htmlcov/
